[bastion]
bastion ansible_host=<BASTION_IP>

[app]
app ansible_host=<APP_PRIVATE_IP>

[app:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -o StrictHostKeyChecking=no -W %h:%p -i ~/.ssh/<your-key>.pem ubuntu@<BASTION_IP>"'

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/<your-key>.pem
ansible_ssh_extra_args='-o StrictHostKeyChecking=no'
